# Regenerable benchmark artifacts — run.sh recreates all of these, and
# keeps the output of runs it does not publish in runs/.
# data/ holds the seeded edge lists (byte-identical from the seed, the
# 1M-node one alone is ~65 MB); results/ stays committable as the
# receipts backing the README numbers.
data/
bin/
runs/
.venv/
__pycache__/
